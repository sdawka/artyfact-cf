{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "artyfact-site",
  "compatibility_date": "2026-10-12",
  "assets": { "directory": "./dist", "html_handling": "drop-trailing-slash", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "artyfact.ing", "custom_domain": true }]
}
