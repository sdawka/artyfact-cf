{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artyfact-platform",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // global_fetch_strictly_public: the health hook fetches preview Workers on workers.dev; without it a Worker-to-Worker
  // fetch on the same zone fails with error 1042 (https://developers.cloudflare.com/workers/runtime-apis/fetch/).

  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // Cloudflare Artifacts (git-backed repos). remote: true even in local dev.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "artyfact", "remote": true }],
  "exports": { "SystemAuthority": { "type": "durable-object", "storage": "sqlite" } },
  "durable_objects": { "bindings": [{ "name": "SYSTEMS", "class_name": "SystemAuthority" }] },
  // CI: the artyfact-ci Worker's Workflow (cross-script), which builds and deploys app commits. Absent from
  // wrangler.test.jsonc, so `env.CI` is optional in code.
  "workflows": [{ "binding": "CI", "name": "artyfact-ci", "class_name": "ArtyfactCI", "script_name": "artyfact-ci" }],
  "queues": { "consumers": [{ "queue": "artyfact-artifacts-events", "max_batch_size": 10, "max_retries": 3 }] },
  // ACCOUNT_ID builds fork remotes (https://<ACCOUNT_ID>.artifacts.cloudflare.net/git/<ns>/<repo>.git); set it in .dev.vars or here.
  // PREVIEW_HOST_ALLOWLIST: extra hosts the health hook may fetch agent-supplied preview URLs from, comma-separated
  // (`app.example.com` exact, `*.example.com` subdomains); *.workers.dev and *.pages.dev are always allowed.
  // FAKE_S1=1: no System One provider key is configured yet, so the fake judge answers (the UI labels those judgments).
  // PUBLIC_URL records the deployed origin. Start lines and task packets use the request origin, so local dev (http://localhost:1337) needs no override.
  // WORKERS_SUBDOMAIN: the account's workers.dev subdomain; CI deploys previews to https://<worker>.<WORKERS_SUBDOMAIN>.workers.dev.
  // ALLOW_LOCAL_PREVIEW=1 (http://localhost / 127.0.0.1 previews) belongs in .dev.vars only, never in deployed vars.
  "vars": { "ARTIFACTS_NAMESPACE": "artyfact", "PUBLIC_URL": "https://artyfact-platform.dawka.workers.dev", "ACCOUNT_ID": "1bae12d5089e4c2ee5c0e62c021a117f", "PREVIEW_HOST_ALLOWLIST": "", "FAKE_S1": "1", "WORKERS_SUBDOMAIN": "dawka" },
  "observability": { "enabled": true }
}
