{
  "name": "@artyfact/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "cf-typegen": "wrangler types worker/env.d.ts",
    "build:fixture": "node scripts/build-fixture.ts",
    "dev:amendment": "vite --config vite.amendment-dev.config.ts --port 5199",
    "build:spa": "vite build --config vite.fixture.config.ts",
    "preview:fixture": "npm run build:spa && vite preview --config vite.fixture.config.ts --port 1338 --strictPort",
    "e2e": "npm run build:spa && playwright test",
    "e2e:live": "npm run build && ARTYFACT_E2E_LIVE=1 playwright test"
  },
  "dependencies": {
    "@artyfact/cli": "*",
    "@artyfact/model": "*",
    "@artyfact/rules": "*",
    "@artyfact/semantic": "*",
    "@artyfact/templates": "*",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.15",
    "@xyflow/react": "^12.12.0",
    "cmdk": "^1.1.1",
    "elkjs": "^0.12.0",
    "hono": "^4.13.13",
    "picomatch": "^4.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@artyfact/templates": "*",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
