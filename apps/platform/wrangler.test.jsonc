// Test-only config: identical to wrangler.jsonc but without the remote `artifacts` binding,
// so tests run offline without a Cloudflare login. Keep in sync.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artyfact-platform",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "exports": { "SystemAuthority": { "type": "durable-object", "storage": "sqlite" } },
  "durable_objects": { "bindings": [{ "name": "SYSTEMS", "class_name": "SystemAuthority" }] },
  "queues": { "consumers": [{ "queue": "artyfact-artifacts-events", "max_batch_size": 10, "max_retries": 3 }] },
  // ACCOUNT_ID builds fork remotes (https://<ACCOUNT_ID>.artifacts.cloudflare.net/git/<ns>/<repo>.git); set it in .dev.vars or here.
  "vars": { "ARTIFACTS_NAMESPACE": "artyfact", "PUBLIC_URL": "http://localhost:5173", "ACCOUNT_ID": "", "PREVIEW_HOST_ALLOWLIST": "" },
  "observability": { "enabled": true }
}
