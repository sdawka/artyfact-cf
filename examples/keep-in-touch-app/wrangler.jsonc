{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keep-in-touch",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "assets": { "directory": "public" },
  "d1_databases": [
    { "binding": "DB", "database_name": "keep-in-touch", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // Deployed identity comes from Cloudflare Access: set ACCESS_AUD and ACCESS_TEAM_DOMAIN. For local runs copy .dev.vars.example to .dev.vars.
  "vars": { "BUILD_ID": "dev" }
}
