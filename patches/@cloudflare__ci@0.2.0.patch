--- /dev/null
+++ b/src/ci/command-failure.ts
@@ -0,0 +1,15 @@
+// Copyright (c) 2026 Cloudflare, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+// Message markers for failures caused by the command itself rather than the
+// infrastructure running it. The Workflow step boundary keeps an error's
+// message but not its class, so callers classify by these markers.
+export const EXIT_CODE_FAILURE = '[ci:exit-code]';
+export const COMMAND_TIMEOUT_FAILURE = '[ci:command-timeout]';
+
+export function isCommandFailure(message: string) {
+  return (
+    message.includes(EXIT_CODE_FAILURE) ||
+    message.includes(COMMAND_TIMEOUT_FAILURE)
+  );
+}
