node_modules
# Build and coverage output only at the repo and package roots, so no Genome node directory named dist or coverage
# is ever hidden (the example System's own tsc output goes to .tsbuild, which is not a node slug).
/dist/
/apps/*/dist/
/packages/*/dist/
/examples/peopling-app/dist/
/examples/peopling-system/.tsbuild/
/coverage/
/apps/*/coverage/
/packages/*/coverage/
.wrangler
.cloudflare
.dev.vars
.env
.artyfact.json
*.log
# Genome node directories may end in .log (operation.contact.log).
!examples/**/*.log
!genome/**/*.log
!packages/*/test/fixtures/**/*.log
.DS_Store
*.tsbuildinfo
.artyfact/

# Local GRREAT sync receipts
docs/grreat/.sync.json

# Local agent working files (reviews, plans, reports)
.superpowers/
